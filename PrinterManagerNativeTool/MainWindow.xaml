<Window x:Class="PrinterManagerNativeTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Printer Manager"
        Width="1220"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Printer Manager"
                               FontSize="29"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="v2"
                               Margin="10,7,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Opacity="0.55"/>
                </StackPanel>
                <TextBlock Text="Gestione e diagnostica rapida delle stampanti Windows"
                           Margin="0,3,0,0"
                           Opacity="0.68"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="RefreshButton"
                        Content="↻  Aggiorna"
                        Click="RefreshButton_Click"/>
                <Button x:Name="ToolsButton"
                        Content="Strumenti  ⋯"
                        Click="ToolsButton_Click"
                        Margin="0,0,0,8">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Riavvia spooler"
                                      Click="RestartSpoolerMenuItem_Click"/>
                            <MenuItem Header="Pulisci spooler"
                                      Click="ClearSpoolerMenuItem_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 ToolTip="Cerca per nome, porta, driver o indirizzo"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="⌕  Cerca stampante, driver, porta o IP..."
                                   Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Opacity="0.48"/>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               x:Name="SummaryText"
                               Text="Caricamento stampanti..."
                               Margin="3,0,0,0"
                               Style="{StaticResource MutedTextStyle}"/>

                    <DataGrid x:Name="PrintersGrid"
                              Grid.Row="4"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="PrintersGrid_SelectionChanged"
                              MouseDoubleClick="PrintersGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stampante"
                                                Binding="{Binding Name}"
                                                Width="2.25*"/>
                            <DataGridTemplateColumn Header="Stato" Width="1.15*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Ellipse x:Name="StatusDot"
                                                     Width="8"
                                                     Height="8"
                                                     Fill="Gray"
                                                     Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}" Value="Pronta">
                                                <Setter TargetName="StatusDot" Property="Fill" Value="LimeGreen"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="Offline">
                                                <Setter TargetName="StatusDot" Property="Fill" Value="Tomato"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="Errore">
                                                <Setter TargetName="StatusDot" Property="Fill" Value="Tomato"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="Carta inceppata">
                                                <Setter TargetName="StatusDot" Property="Fill" Value="Orange"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="Carta esaurita">
                                                <Setter TargetName="StatusDot" Property="Fill" Value="Orange"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="Intervento richiesto">
                                                <Setter TargetName="StatusDot" Property="Fill" Value="Orange"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Job"
                                                Binding="{Binding JobCount}"
                                                Width="0.55*"/>
                            <DataGridTextColumn Header="Porta"
                                                Binding="{Binding PortName}"
                                                Width="1.35*"/>
                            <DataGridTextColumn Header="Predef."
                                                Binding="{Binding DefaultText}"
                                                Width="0.7*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="SelectedPrinterName"
                                   Text="Seleziona una stampante"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedPrinterStatus"
                                   Margin="0,5,0,15"
                                   FontWeight="SemiBold"
                                   Opacity="0.78"/>

                        <Separator Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Driver" FontWeight="SemiBold" Margin="0,0,8,9"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DriverValue" Text="—" TextWrapping="Wrap" Margin="0,0,0,9"/>

                            <TextBlock Grid.Row="1" Text="Porta" FontWeight="SemiBold" Margin="0,0,8,9"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PortValue" Text="—" TextWrapping="Wrap" Margin="0,0,0,9"/>

                            <TextBlock Grid.Row="2" Text="Indirizzo" FontWeight="SemiBold" Margin="0,0,8,9"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HostValue" Text="—" TextWrapping="Wrap" Margin="0,0,0,9"/>

                            <TextBlock Grid.Row="3" Text="Job" FontWeight="SemiBold" Margin="0,0,8,9"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="JobsValue" Text="—" Margin="0,0,0,9"/>

                            <TextBlock Grid.Row="4" Text="Predefinita" FontWeight="SemiBold" Margin="0,0,8,9"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DefaultValue" Text="—" Margin="0,0,0,9"/>
                        </Grid>

                        <TextBlock Text="Azioni"
                                   Style="{StaticResource SectionHeaderStyle}"/>

                        <WrapPanel x:Name="PrinterActionsPanel" IsEnabled="False">
                            <Button Content="Apri coda"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OpenQueueButton_Click"/>
                            <Button Content="Preferenze" Click="PreferencesButton_Click"/>
                            <Button Content="Proprietà" Click="PropertiesButton_Click"/>
                            <Button x:Name="SetDefaultButton"
                                    Content="Imposta predefinita"
                                    Click="SetDefaultButton_Click"/>
                            <Button Content="Pagina di prova" Click="TestPageButton_Click"/>
                            <Button x:Name="OpenWebButton"
                                    Content="Web UI"
                                    Click="OpenWebButton_Click"/>
                        </WrapPanel>

                        <TextBlock Text="Diagnostica rete"
                                   Style="{StaticResource SectionHeaderStyle}"/>

                        <StackPanel x:Name="NetworkDiagnosticsPanel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Ping" FontWeight="SemiBold" Margin="0,0,8,9"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PingValue" Text="—" TextWrapping="Wrap" Margin="0,0,0,9"/>

                                <TextBlock Grid.Row="1" Text="RAW 9100" FontWeight="SemiBold" Margin="0,0,8,9"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RawValue" Text="—" TextWrapping="Wrap" Margin="0,0,0,9"/>
                            </Grid>

                            <Button x:Name="DiagnoseButton"
                                    Content="Esegui diagnostica"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False"
                                    Click="DiagnoseButton_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="NoNetworkDiagnosticsText"
                                   Text="Questa porta non espone un indirizzo di rete utilizzabile per la diagnostica."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Style="{StaticResource MutedTextStyle}"/>

                        <Button x:Name="CopyDiagnosticButton"
                                Content="Copia report"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                Click="CopyDiagnosticButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusBarText"
                       Text="Pronto"
                       Style="{StaticResource MutedTextStyle}"/>
            <TextBlock Grid.Column="1"
                       x:Name="SpoolerStatusText"
                       Text="●  Spooler: —"
                       Style="{StaticResource MutedTextStyle}"/>
        </Grid>
    </Grid>
</Window>
