<Window x:Class="PrinterManagerNativeTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Printer Manager"
        Width="1180"
        Height="720"
        MinWidth="920"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Printer Manager"
                           FontSize="28"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Gestione e diagnostica rapida delle stampanti Windows"
                           Margin="0,4,0,0"
                           Opacity="0.72"/>
            </StackPanel>

            <WrapPanel Grid.Column="1"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Button x:Name="RestartSpoolerButton"
                        Content="Riavvia spooler"
                        Click="RestartSpoolerButton_Click"/>
                <Button x:Name="ClearSpoolerButton"
                        Content="Pulisci spooler"
                        Click="ClearSpoolerButton_Click"/>
                <Button x:Name="RefreshButton"
                        Content="Aggiorna"
                        Click="RefreshButton_Click"
                        Margin="0,0,0,8"/>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchBox"
                             ToolTip="Cerca per nome, porta, driver o indirizzo"
                             TextChanged="SearchBox_TextChanged"/>

                    <DataGrid x:Name="PrintersGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionChanged="PrintersGrid_SelectionChanged"
                              MouseDoubleClick="PrintersGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stampante" Binding="{Binding Name}" Width="2.2*"/>
                            <DataGridTextColumn Header="Stato" Binding="{Binding StatusText}" Width="1.1*"/>
                            <DataGridTextColumn Header="Job" Binding="{Binding JobCount}" Width="0.55*"/>
                            <DataGridTextColumn Header="Porta" Binding="{Binding PortName}" Width="1.25*"/>
                            <DataGridTextColumn Header="Default" Binding="{Binding DefaultText}" Width="0.7*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="SelectedPrinterName"
                                   Text="Seleziona una stampante"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedPrinterStatus"
                                   Margin="0,4,0,14"
                                   Opacity="0.75"/>

                        <Separator Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Driver" FontWeight="SemiBold" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DriverValue" Text="—" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Text="Porta" FontWeight="SemiBold" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PortValue" Text="—" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Text="Indirizzo" FontWeight="SemiBold" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HostValue" Text="—" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="3" Text="Job" FontWeight="SemiBold" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="JobsValue" Text="—" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="4" Text="Default" FontWeight="SemiBold" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DefaultValue" Text="—" Margin="0,0,0,8"/>
                        </Grid>

                        <TextBlock Text="Azioni"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Margin="0,14,0,10"/>

                        <WrapPanel x:Name="PrinterActionsPanel" IsEnabled="False">
                            <Button Content="Apri coda" Click="OpenQueueButton_Click"/>
                            <Button Content="Preferenze" Click="PreferencesButton_Click"/>
                            <Button Content="Proprietà" Click="PropertiesButton_Click"/>
                            <Button Content="Imposta default" Click="SetDefaultButton_Click"/>
                            <Button Content="Pagina di prova" Click="TestPageButton_Click"/>
                            <Button x:Name="OpenWebButton" Content="Web UI" Click="OpenWebButton_Click"/>
                        </WrapPanel>

                        <TextBlock Text="Diagnostica rete"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Margin="0,12,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Ping" FontWeight="SemiBold" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PingValue" Text="—" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Text="RAW 9100" FontWeight="SemiBold" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RawValue" Text="—" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        </Grid>

                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="DiagnoseButton"
                                    Content="Esegui diagnostica"
                                    IsEnabled="False"
                                    Click="DiagnoseButton_Click"/>
                            <Button x:Name="CopyDiagnosticButton"
                                    Content="Copia report"
                                    IsEnabled="False"
                                    Click="CopyDiagnosticButton_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusBarText" Text="Pronto" Opacity="0.72"/>
            <TextBlock Grid.Column="1" x:Name="SpoolerStatusText" Text="Spooler: —" Opacity="0.72"/>
        </Grid>
    </Grid>
</Window>
